# /etc/dipbuy.env, mode 600 owned by root (systemd reads it before starting the bot).
# Comments must be on their own line: systemd keeps a trailing "# ..." as part of the value.
# Shown as the first line of every Telegram message.
BOT_NAME=dipbuy
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Send your bot any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_CHAT_ID=
# No Binance keys: live trading is off (LIVE_TRADING = False in bot.py).
